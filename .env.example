# Copie ce fichier en ".env" pour tester en local (le .env n'est JAMAIS envoyé sur GitHub).
# Sur Railway, mets ces valeurs dans l'onglet "Variables" à la place.

# Token donné par @BotFather
TELEGRAM_TOKEN=
# Ton identifiant Telegram (nombre, donné par @userinfobot)
TELEGRAM_CHAT_ID=
# Clé API Helius (https://dashboard.helius.dev)
HELIUS_API_KEY=

# Chemin du fichier SQLite. Sur Railway : /data/bot.db (volume monté sur /data)
DB_PATH=./data/bot.db

# Domaine public (Railway > Settings > Networking > Generate Domain)
# Helius enverra les transactions sur PUBLIC_URL/helius
PUBLIC_URL=

# Secret envoyé par Helius dans l'en-tête Authorization (obligatoire pour les alertes)
# Génère-le avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
HELIUS_WEBHOOK_SECRET=

# Optionnel
# ANALYSE_JOURS=30
# ANALYSE_MAX_TRANSACTIONS=5000
# ANALYSE_HEBDO_HEURE=10
# FUSEAU_HORAIRE=Europe/Paris
# Veille Telegram (facultatif, voir le README : my.telegram.org)
# TG_API_ID=
# TG_API_HASH=
# TGLOGIN_PASSWORD=          (12 caractères minimum, protège /tglogin et chiffre la session)
# VEILLE_MIN_CANAUX=2
# VEILLE_FENETRE_MIN=30
# IA (facultatif) : une des deux clés suffit
# XAI_API_KEY=               (Grok)
# ANTHROPIC_API_KEY=         (Claude)
# IA_FOURNISSEUR=grok        (si les deux sont présentes)
# IA_MODELE=
# IA_MAX_PAR_JOUR=200
# NOUVEAUX_TOKENS_MAX_PAR_HEURE=20
# SCAN_DELAI_S=120
# SCAN_MC_MIN_USD=10000
# SCAN_TX_5MIN_MIN=20
# DEV_MAX_TOKENS_ANALYSES=30
# RULES_PATH=rules.json
# ANALYSE_TOKEN_CACHE_S=120
# HELIUS_TRANSACTION_TYPES=ANY   (ou SWAP,BUY pour économiser des crédits, mais sans pump.fun)
# SIGNAL_FORT_MIN_WALLETS=2
# SIGNAL_FORT_MINUTES=10
# INTERVALLE_SURVEILLANCE=60
# LOG_LEVEL=INFO
