# Copie ce fichier en ".env" pour tester en local (le .env n'est JAMAIS envoyé sur GitHub).
# Sur Railway, mets ces valeurs dans l'onglet "Variables" à la place.

# Token donné par @BotFather
TELEGRAM_TOKEN=
# Ton identifiant Telegram (nombre, donné par @userinfobot)
TELEGRAM_CHAT_ID=
# Clé API Helius (https://dashboard.helius.dev)
HELIUS_API_KEY=

# Chemin du fichier SQLite. Sur Railway : /data/bot.db (volume monté sur /data)
DB_PATH=./data/bot.db

# Domaine public (Railway > Settings > Networking > Generate Domain)
# Helius enverra les transactions sur PUBLIC_URL/helius
PUBLIC_URL=

# Optionnel
# WEBHOOK_SECRET=            (calculé automatiquement à partir de HELIUS_API_KEY si vide)
# SIGNAL_FORT_MIN_WALLETS=2
# SIGNAL_FORT_MINUTES=10
# INTERVALLE_SURVEILLANCE=60
# LOG_LEVEL=INFO
